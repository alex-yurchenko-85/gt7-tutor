{
  "name": "gt7-tutor",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build:packages": "pnpm --filter \"./packages/**\" run build",
    "build": "pnpm -r run build",
    "start": "node apps/server/dist/main.js",
    "typecheck": "pnpm build:packages && pnpm -r run typecheck",
    "test": "vitest run",
    "test:integration": "pnpm --filter @gt7/server... run build && pnpm --filter @gt7/server run test:integration",
    "test:coverage": "vitest run --coverage",
    "test:integration:coverage": "pnpm --filter @gt7/server... run build && pnpm --filter @gt7/server run test:integration --coverage",
    "db:up": "docker compose up -d --wait postgres",
    "db:migrate": "knex --knexfile apps/server/db/knexfile.cjs migrate:latest",
    "db:reset": "node tools/setup/db-reset.ts",
    "capture": "node --conditions=source tools/capture.ts",
    "replay": "node --conditions=source tools/replay.ts",
    "race:import": "pnpm --filter @gt7/server... run build && node --conditions=source tools/import-race.ts",
    "fixture": "node tools/make-fixture.ts",
    "evaluate-coach": "node --conditions=source tools/evaluate-coach.ts",
    "catalogue:build": "node --conditions=source tools/build-catalogue.ts",
    "audio:generate": "pnpm --dir tools/audio install --frozen-lockfile && node --conditions=source tools/generate-audio.ts",
    "prepare": "husky",
    "commitlint": "commitlint",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/git": "11.0.1",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "husky": "9.1.7",
    "knex": "3.3.0",
    "pg": "8.23.1",
    "semantic-release": "26.0.1",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "release": {
    "branches": [
      "main"
    ],
    "tagFormat": "v${version}",
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/changelog",
        {
          "changelogFile": "CHANGELOG.md",
          "changelogTitle": "# Changelog"
        }
      ],
      [
        "@semantic-release/git",
        {
          "assets": [
            "CHANGELOG.md"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]"
        }
      ],
      "@semantic-release/github"
    ]
  }
}
